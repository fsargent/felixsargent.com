#!/usr/bin/env bash
# Kept for muscle memory: delegates to the mise task so there is one way to run the site.
set -euo pipefail
cd "$(dirname "$0")/.."
if ! command -v mise >/dev/null 2>&1; then
  echo "mise is not installed. Install it with: curl https://mise.run | sh  (or: brew install mise)" >&2
  exit 1
fi
exec mise run serve "$@"
